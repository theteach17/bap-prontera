/** Optional final-document queue; booking status remains pending until PDF is committed. */
const PRONTERA_JOB_HEADERS=['Job ID','Booking ID','Approval ID','State','Attempts','Next Run','Updated At','Last Error'];
function pronteraJobSheet_(create){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName('PronteraJobs');if(!s&&create){s=ss.insertSheet('PronteraJobs');s.appendRow(PRONTERA_JOB_HEADERS);}if(s&&s.getRange(1,1,1,PRONTERA_JOB_HEADERS.length).getValues()[0].some((v,i)=>v!==PRONTERA_JOB_HEADERS[i]))throw new Error('JOB_SCHEMA_INVALID');return s;}
/** Installation is manual, owner-only; never changes existing handlers. */
function setupPronteraFinalWorker(){requirePronteraEditor_();const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw new Error('ระบบกำลังทำงาน');try{pronteraJobSheet_(true);const existing=ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='runPronteraFinalWorker_');if(existing.length>1)throw new Error('พบ Trigger Worker ซ้ำ กรุณาตรวจสอบก่อนเปิด');if(!existing.length)ScriptApp.newTrigger('runPronteraFinalWorker_').timeBased().everyMinutes(1).create();return {ready:true,enabled:pronteraFlag_('PRONTERA_FINAL_WORKER_ENABLED')};}finally{lock.releaseLock();}}
/** Called under the approval lock. Fall back to synchronous finalization if worker not healthy. */
function pronteraQueueFinalPdf_(approvalId,bookingId){if(!pronteraFlag_('PRONTERA_FINAL_WORKER_ENABLED'))return false;const heartbeat=Number(PropertiesService.getScriptProperties().getProperty('PRONTERA_FINAL_WORKER_HEARTBEAT'));if(!heartbeat||Date.now()-heartbeat>180000||heartbeat>Date.now()+60000)return false;try{const s=pronteraJobSheet_(false);if(!s)return false;const key='FINAL:'+approvalId,rows=s.getDataRange().getValues().slice(1).filter(r=>String(r[0])===key);if(rows.length>1)throw new Error('JOB_DUPLICATE');if(rows.length)return ['QUEUED','RUNNING','RETRY'].includes(rows[0][3]);s.appendRow([key,bookingId,approvalId,'QUEUED',0,new Date(),new Date(),'']);return true;}catch(e){pronteraBestEffortLog_('System','Final worker enqueue fallback',approvalId+' | '+e.message);return false;}}
/** Resolve one durable job; shared lock serializes against edit, cancel and signing. */
function pronteraProcessFinalJob_(r){const bookingId=String(r[1]),approvalId=String(r[2]),bookingStatus=getBookingStatusById_(bookingId);if([BOOKING_STATUS.CANCELLED,BOOKING_STATUS.REJECTED].includes(bookingStatus))return 'SUPERSEDED';const flows=getApprovalFlowRecordsForBooking_(bookingId),matching=flows.filter(f=>f.approvalId===approvalId);if(matching.length!==1)throw new Error('JOB_FLOW_INVALID');const flow=matching[0],c=flow.cols;if(['SUPERSEDED','CANCELLED','REJECTED'].includes(flow.status))return 'SUPERSEDED';if(flows.some(f=>f.approvalId!==approvalId&&isApprovalFlowPendingStatus_(f.status)))throw new Error('JOB_MULTIPLE_ACTIVE_FLOWS');
  validateApprovalCompletionSequence_(approvalId);
  if(flow.status==='COMPLETED'){const fileId=normalizeText_(getCell_(flow.row,c.finalSignedPdfFileId)),url=normalizeText_(getCell_(flow.row,c.finalSignedPdfUrl));if(!fileId||!url)throw new Error('JOB_COMPLETED_EVIDENCE_MISSING');DriveApp.getFileById(fileId).getBlob();if(bookingStatus!==BOOKING_STATUS.APPROVED)markBookingApproved_(bookingId,'ตรวจคืนสถานะจาก Final PDF ที่สร้างแล้ว');return 'DONE';}
  if(flow.status!=='PENDING_DEPUTY_DIRECTOR'||Number(getCell_(flow.row,c.currentStep))!==3||![BOOKING_STATUS.PENDING_APPROVAL,BOOKING_STATUS.APPROVAL_ERROR].includes(bookingStatus))throw new Error('JOB_STATUS_INVALID');
  finalizeApprovalFlow_(approvalId,'Prontera Worker','');return 'DONE';}
/** Private trigger handler; one job per execution, with bounded retries and stale-run recovery. */
function runPronteraFinalWorker_(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return {busy:true};try{const props=PropertiesService.getScriptProperties();props.setProperty('PRONTERA_FINAL_WORKER_HEARTBEAT',String(Date.now()));if(!pronteraFlag_('PRONTERA_FINAL_WORKER_ENABLED'))return {enabled:false};const s=pronteraJobSheet_(false);if(!s)throw new Error('JOB_SCHEMA_MISSING');const rows=s.getDataRange().getValues(),now=Date.now();const i=rows.findIndex((r,i)=>i>0&&((['QUEUED','RETRY'].includes(r[3])&&new Date(r[5]).getTime()<=now)||(r[3]==='RUNNING'&&new Date(r[6]).getTime()+7*60000<=now)));if(i<1)return {idle:true};const r=rows[i],previous=Number(r[4]||0);if(previous>=3){s.getRange(i+1,4,1,5).setValues([['FAILED',previous,new Date(),new Date(),'Retry limit reached; verify existing PDF and recover via Admin']]);return {state:'FAILED',jobId:r[0]};}const attempt=previous+1;s.getRange(i+1,4,1,5).setValues([['RUNNING',attempt,new Date(),new Date(),'']]);try{const state=pronteraProcessFinalJob_(r);s.getRange(i+1,4,1,5).setValues([[state,attempt,new Date(),new Date(),'']]);return {state:state,jobId:r[0]};}catch(e){const failed=attempt>=3,state=failed?'FAILED':'RETRY';s.getRange(i+1,4,1,5).setValues([[state,attempt,new Date(Date.now()+Math.min(15,attempt*2)*60000),new Date(),pronteraSheetText_(sanitizePlainText_(e.message,500))]]);pronteraBestEffortLog_('System','Final worker '+state,r[0]+' | '+e.message);return {state:state,jobId:r[0]};}}finally{lock.releaseLock();}}
/** Manual diagnostic runner; cannot be invoked by non-owner web users. */
function runPronteraFinalWorkerNow(){requirePronteraEditor_();return runPronteraFinalWorker_();}
/** Staff-visible state counts; no approval IDs or tokens. */
function getPronteraWorkerHealth(sessionToken){requireUser_(sessionToken,['Admin','Officer']);const s=pronteraJobSheet_(false),counts={};if(s)s.getDataRange().getValues().slice(1).forEach(r=>{counts[r[3]]=(counts[r[3]]||0)+1;});return {enabled:pronteraFlag_('PRONTERA_FINAL_WORKER_ENABLED'),heartbeat:Number(PropertiesService.getScriptProperties().getProperty('PRONTERA_FINAL_WORKER_HEARTBEAT'))||0,counts:counts};}
