/** Optional maintenance windows, independent of booking status. No automatic cancellation. */
const PRONTERA_MAINTENANCE_HEADERS=['ID','Room ID','Start Time','End Time','Reason','Status','Created At','Actor'];
function pronteraMaintenanceSheet_(create){
  const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName('RoomMaintenance');
  if(!s&&create){s=ss.insertSheet('RoomMaintenance');s.appendRow(PRONTERA_MAINTENANCE_HEADERS);}
  if(s&&s.getRange(1,1,1,PRONTERA_MAINTENANCE_HEADERS.length).getValues()[0].some((v,i)=>v!==PRONTERA_MAINTENANCE_HEADERS[i]))throw new Error('MAINTENANCE_SCHEMA_INVALID');
  return s;
}
function pronteraMaintenanceRows_(){if(!pronteraFlag_('PRONTERA_MAINTENANCE_ENABLED'))return [];const s=pronteraMaintenanceSheet_(false);return s?s.getDataRange().getValues().slice(1):[];}
function pronteraMaintenanceBusy_(start,end){
  const rooms=new Set();pronteraMaintenanceRows_().forEach(r=>{if(r[5]!=='ACTIVE')return;const a=pronteraDate_(r[2]),b=pronteraDate_(r[3]);if(!r[1]||!Number.isFinite(a.getTime())||!Number.isFinite(b.getTime())||b<=a)throw new Error('MAINTENANCE_DATA_INVALID');if(pronteraOverlaps_(start,end,a,b))rooms.add(normalizeText_(r[1]));});return rooms;
}
/** Read-only staff view. */
function getPronteraMaintenance(sessionToken){requireUser_(sessionToken,['Admin','Officer']);return {enabled:pronteraFlag_('PRONTERA_MAINTENANCE_ENABLED'),rows:pronteraMaintenanceRows_().filter(r=>r[5]==='ACTIVE').map(r=>({id:String(r[0]),room:String(r[1]),start:pronteraDate_(r[2]).toISOString(),end:pronteraDate_(r[3]).toISOString(),reason:String(r[4])}))};}
/** Admin creates window only if no existing blocking booking or window overlaps. */
function createPronteraMaintenance(form,sessionToken){const user=requireUser_(sessionToken,['Admin']);if(!pronteraFlag_('PRONTERA_MAINTENANCE_ENABLED'))throw new Error('ยังไม่ได้เปิดระบบปิดห้อง');const range=pronteraRange_(form.start,form.end),reason=sanitizePlainText_(form.reason,300),roomId=normalizeText_(form.roomId);if(!reason||!roomId||range.start<new Date())throw new Error('กรุณาระบุห้อง เหตุผล และช่วงเวลาในอนาคต');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw new Error('ระบบกำลังดำเนินการ');try{if(!getRoomById_(roomId))throw new Error('ไม่พบห้อง');if(pronteraMaintenanceBusy_(range.start,range.end).has(roomId))throw new Error('ช่วงเวลาปิดห้องทับซ้อน');const b=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_BOOKINGS),c=getBookingCols_(b);const collision=b.getDataRange().getValues().slice(1).some(r=>normalizeText_(getCell_(r,c.roomId))===roomId&&isBookingBlockingRoom_(getCell_(r,c.status))&&pronteraOverlaps_(range.start,range.end,pronteraDate_(getCell_(r,c.start)),pronteraDate_(getCell_(r,c.end))));if(collision)throw new Error('มีรายการจองที่กันห้องอยู่ ไม่สามารถปิดห้องโดยอัตโนมัติ');const id=Utilities.getUuid();pronteraMaintenanceSheet_(true).appendRow([id,roomId,range.start,range.end,pronteraSheetText_(reason),'ACTIVE',new Date(),pronteraSheetText_(user.email||user.username)]);return {id:id};}finally{lock.releaseLock();}}
/** Release window; no effect on historical bookings. */
function cancelPronteraMaintenance(id,sessionToken){const user=requireUser_(sessionToken,['Admin']);if(!pronteraFlag_('PRONTERA_MAINTENANCE_ENABLED'))throw new Error('ยังไม่ได้เปิดระบบปิดห้อง');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw new Error('ระบบกำลังดำเนินการ');try{const s=pronteraMaintenanceSheet_(false);if(!s)throw new Error('ไม่พบรายการ');const rows=s.getDataRange().getValues(),i=rows.findIndex((r,i)=>i>0&&String(r[0])===String(id)&&r[5]==='ACTIVE');if(i<1)throw new Error('ไม่พบรายการปิดห้องที่ยังมีผล');s.getRange(i+1,6).setValue('CANCELLED');pronteraBestEffortLog_(user.email,'Cancel maintenance',String(id));return {cancelled:true};}finally{lock.releaseLock();}}
