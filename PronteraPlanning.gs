/** Plan weekly occurrences without making a reservation or reusing consent automatically. */
function getPronteraRecurringPlan(form){requirePronteraPrincipal_();const room=getRoomById_(form.roomId),count=Number(form.count),people=Number(form.headcount),range=pronteraRange_(form.start,form.end);if(!room||!Number.isInteger(count)||count<2||count>12||!Number.isInteger(people)||people<1||(room.capacity>0&&people>room.capacity)||range.start<new Date()||range.end-range.start>7*86400000)throw new Error('กรุณาระบุห้อง จำนวนคน และช่วงเวลาที่ถูกต้อง (2–12 สัปดาห์)');const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_BOOKINGS),c=getBookingCols_(sh),busy=sh.getDataRange().getValues().slice(1).filter(r=>normalizeText_(getCell_(r,c.roomId))===room.roomId&&isBookingBlockingRoom_(getCell_(r,c.status))).map(r=>({a:pronteraDate_(getCell_(r,c.start)),b:pronteraDate_(getCell_(r,c.end))}));const blocks=pronteraMaintenanceRows_().filter(r=>r[1]===room.roomId&&r[5]==='ACTIVE').map(r=>({a:pronteraDate_(r[2]),b:pronteraDate_(r[3])}));const fmt=d=>Utilities.formatDate(d,'Asia/Bangkok',"yyyy-MM-dd'T'HH:mm");return Array.from({length:count},(_,i)=>{const a=new Date(range.start.getTime()+i*7*86400000),b=new Date(range.end.getTime()+i*7*86400000);return {start:fmt(a),end:fmt(b),available:!busy.concat(blocks).some(r=>pronteraOverlaps_(a,b,r.a,r.b))};});}
/** Domain-only read-only room display. No topics, requesters, email, documents or approval tokens. */
function getPronteraRoomDisplay(){requirePronteraPrincipal_();const now=new Date(),limit=new Date(now.getTime()+24*3600000),sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_BOOKINGS),c=getBookingCols_(sh),index=new Map();sh.getDataRange().getValues().slice(1).forEach(r=>{if(!isBookingBlockingRoom_(getCell_(r,c.status)))return;const id=normalizeText_(getCell_(r,c.roomId)),a=pronteraDate_(getCell_(r,c.start)),b=pronteraDate_(getCell_(r,c.end));if(!Number.isFinite(a.getTime())||!Number.isFinite(b.getTime())||!pronteraOverlaps_(now,limit,a,b))return;const items=index.get(id)||[];items.push({a:a,b:b,status:normalizeBookingStatus_(getCell_(r,c.status))});index.set(id,items);});const maintenance=pronteraMaintenanceBusy_(now,new Date(now.getTime()+1));return {at:now.toISOString(),rooms:getActiveRooms_().map(room=>{const items=(index.get(room.roomId)||[]).sort((a,b)=>a.a-b.a),current=items.find(r=>r.a<=now&&now<r.b),next=items.find(r=>r.a>now);return {name:room.roomName,capacity:room.capacity,state:maintenance.has(room.roomId)?'MAINTENANCE':current?current.status===BOOKING_STATUS.APPROVED?'RESERVED':'PENDING':'FREE',until:current?current.b.toISOString():'',next:next?next.a.toISOString():''};})};}

/** Canonical domain deployment URL for the display, never accepts a client URL. */
function getPronteraRoomDisplayUrl(){requirePronteraPrincipal_();return getWebAppUrl_()+'?page=display';}
